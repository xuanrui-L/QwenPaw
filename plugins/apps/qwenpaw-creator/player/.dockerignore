# Dockerfile 只 COPY pyproject.toml / ivb/ / run.sh,其余一律不进上下文。
# 不加这个文件,构建上下文会被 .e2e 的验证包撑到数百 MB。

# 端到端验证产物(修正包 + 上传后的数据目录)
.e2e/

# 构建与打包中间产物
build/
dist/
*.egg-info/

# 测试与文档不进镜像
tests/
docs/

# 缓存与字节码
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# 本地运行产物
*.db
*.db-wal
*.db-shm
.venv/
venv/
.env

# 杂项
.DS_Store
.gitignore
.gitattributes
